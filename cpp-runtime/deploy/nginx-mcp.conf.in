# Use a dedicated client CA (one issuing CA, no intermediates), and a per-station
# backend token shared only with the loopback adapter. Keep the rendered file private.
worker_processes 1;
pid nginx.pid;
error_log stderr warn;

events {
    worker_connections 64;
}

http {
    client_body_temp_path client-body;
    proxy_temp_path proxy-temp;
    fastcgi_temp_path fastcgi-temp;
    uwsgi_temp_path uwsgi-temp;
    scgi_temp_path scgi-temp;

    # Authorize exact certificate serials issued by this station's trusted CA.
    # A valid certificate with an unlisted serial does not grant station access.
    map $ssl_client_serial $station_authorized {
        default 0;
        "@ALLOWED_CLIENT_SERIAL@" 1;
    }
    map $http_host $mcp_host_allowed {
        default 0;
        "@GATEWAY_NAME@" 1;
        "@GATEWAY_NAME@:@GATEWAY_PORT@" 1;
    }
    # Audit a verified certificate serial and a status only (no headers or bodies).
    log_format mcp_audit '$time_iso8601 mcp tls=$ssl_client_verify serial=$ssl_client_serial status=$status';
    limit_req_zone $server_name zone=mcp_rate:1m rate=12r/s;

    server {
        listen @GATEWAY_BIND@ ssl;
        server_name @GATEWAY_NAME@;
        ssl_certificate "@SERVER_CERT@";
        ssl_certificate_key "@SERVER_KEY@";
        ssl_client_certificate "@CLIENT_CA@";
        ssl_verify_client on;
        ssl_verify_depth 1;
        ssl_protocols TLSv1.2 TLSv1.3;
        access_log @AUDIT_LOG@ mcp_audit;

        client_max_body_size 16k;
        client_header_timeout 5s;
        client_body_timeout 5s;
        send_timeout 5s;
        keepalive_timeout 10s;

        location = /mcp {
            if ($mcp_host_allowed = 0) { return 403; }
            if ($station_authorized = 0) { return 403; }

            limit_req zone=mcp_rate burst=16 nodelay;
            limit_req_status 429;
            proxy_connect_timeout 2s;
            proxy_send_timeout 5s;
            proxy_read_timeout 5s;
            proxy_http_version 1.1;
            proxy_set_header Host "127.0.0.1:@BACKEND_PORT@";
            proxy_set_header Authorization "Bearer @BACKEND_TOKEN@";
            proxy_set_header Connection "";
            proxy_pass http://127.0.0.1:@BACKEND_PORT@;
        }

        location / { return 404; }
    }
}
